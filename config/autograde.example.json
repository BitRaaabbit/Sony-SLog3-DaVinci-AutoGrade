{
  "schema_version": 2,
  "workflow_status": "development_preflight_only",
  "source": {
    "required_primaries": "Sony S-Gamut3.Cine",
    "required_gamma": "S-Log3",
    "camera_model": "report_only",
    "metadata_confirmation": "required",
    "reject_mixed_resolution": true,
    "reject_mixed_frame_rate": true,
    "reject_mixed_gamma_or_primaries": true
  },
  "batch": {
    "width": 1920,
    "height": 1080,
    "frame_rate": 25.0,
    "source_files_manifest": "source_files.txt"
  },
  "resolve": {
    "interface": "internal_workspace_lua",
    "object_entry": "app:GetResolve()",
    "color_science": "DaVinci YRGB Color Managed",
    "automatic_color_management": false,
    "timeline_color_space": "DaVinci Wide Gamut / DaVinci Intermediate",
    "output_color_space": "Rec.709 Gamma 2.4"
  },
  "look": {
    "name": "Neutral Safe",
    "status": "test_candidate_not_approved",
    "global_warming": false,
    "lut": false,
    "sharpen": false,
    "noise_reduction": false,
    "candidate": {
      "contrast": 1.08,
      "pivot": 0.44,
      "color_boost": 0,
      "saturation": 50,
      "highlights": -4,
      "temperature": 0,
      "tint": 0
    }
  },
  "safety": {
    "source_read_only": true,
    "overwrite": false,
    "first_test_max_clips": 3,
    "batch_size": 10,
    "require_human_test_approval": true
  },
  "output": {
    "mode": "Individual Clips",
    "container": "MP4",
    "video_codec": "H.264",
    "quality": "Best",
    "audio_codec": "AAC",
    "audio_sample_rate": 48000
  }
}
